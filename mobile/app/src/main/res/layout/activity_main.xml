<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:keepScreenOn="true"
    tools:context=".MainActivity">

    <TextureView
        android:id="@+id/localPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/bg_panel">

        <!-- Status -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:minHeight="38dp"
            android:text="Basta tocar em CONECTAR."
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <!-- Botão principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_btn_primary"
            android:letterSpacing="0.08"
            android:text="CONECTAR E TRANSMITIR"
            android:textAllCaps="true"
            android:textColor="@color/bg"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:enabled="false"
            app:backgroundTint="@null"
            app:cornerRadius="2dp"
            app:rippleColor="#22000000" />

        <!-- Dispositivos encontrados (expansível) -->
        <TextView
            android:id="@+id/devicesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:padding="10dp"
            android:text="DISPOSITIVOS ENCONTRADOS ▸"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Avançado (expansível) -->
        <TextView
            android:id="@+id/advancedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_panel_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:padding="10dp"
            android:text="AVANÇADO ▸"
            android:textAllCaps="true"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/advancedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/serverIpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:hint="IP do servidor (vazio = automático)"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/roomCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:hint="Código da sala (vazio = automático)"
                android:inputType="number"
                android:maxLength="6"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manualConnectButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_outline"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:text="CONECTAR MANUALMENTE"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="13sp"
                app:backgroundTint="@null"
                app:cornerRadius="2dp" />
        </LinearLayout>

        <!-- Controles da câmera (ícones) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/cameraButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_panel_dark"
                android:contentDescription="Câmera"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_camera"
                android:tint="@color/btn_icon"
                android:enabled="false" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/rotateButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_panel_dark"
                android:contentDescription="Girar 90 graus"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_rotate"
                android:tint="@color/btn_icon"
                android:enabled="false" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/mirrorButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel_dark"
                android:contentDescription="Espelho"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mirror"
                android:tint="@color/btn_icon"
                android:enabled="false" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>